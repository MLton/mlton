scanString Char.scan "" = NONE
scanString Char.scan "\\  \\" = NONE
scanString Char.scan "\\  \\abc" = SOME (#"a", "bc")
scanString Char.scan "abc\\  \\" = SOME (#"a", "bc\\  \\")
scanString Char.scan "\\  \\abc\\  \\" = SOME (#"a", "bc\\  \\")
scanString Char.scan "abc\\  \\def\\  \\ghi" = SOME (#"a", "bc\\  \\def\\  \\ghi")
scanString Char.scan "\\n" = SOME (#"\n", "")
scanString Char.scan "\\nabc" = SOME (#"\n", "abc")
scanString Char.scan "abc\\n" = SOME (#"a", "bc\\n")
scanString Char.scan "\\nabc\\n" = SOME (#"\n", "abc\\n")
scanString Char.scan "abc\\ndef\\nghi" = SOME (#"a", "bc\\ndef\\nghi")
scanString Char.scan "\\q" = NONE
scanString Char.scan "\\qabc" = NONE
scanString Char.scan "abc\\q" = SOME (#"a", "bc\\q")
scanString Char.scan "\\qabc\\q" = NONE
scanString Char.scan "abc\\qdef\\qghi" = SOME (#"a", "bc\\qdef\\qghi")
scanString Char.scan "\n" = NONE
scanString Char.scan "\nabc" = NONE
scanString Char.scan "abc\n" = SOME (#"a", "bc\n")
scanString Char.scan "\nabc\n" = NONE
scanString Char.scan "abc\ndef\nghi" = SOME (#"a", "bc\ndef\nghi")

scanString String.scan "" = SOME ("", "")
scanString String.scan "\\  \\" = SOME ("", "")
scanString String.scan "\\  \\abc" = SOME ("abc", "")
scanString String.scan "abc\\  \\" = SOME ("abc", "")
scanString String.scan "\\  \\abc\\  \\" = SOME ("abc", "")
scanString String.scan "abc\\  \\def\\  \\ghi" = SOME ("abcdefghi", "")
scanString String.scan "\\n" = SOME ("\n", "")
scanString String.scan "\\nabc" = SOME ("\nabc", "")
scanString String.scan "abc\\n" = SOME ("abc\n", "")
scanString String.scan "\\nabc\\n" = SOME ("\nabc\n", "")
scanString String.scan "abc\\ndef\\nghi" = SOME ("abc\ndef\nghi", "")
scanString String.scan "\\q" = NONE
scanString String.scan "\\qabc" = NONE
scanString String.scan "abc\\q" = SOME ("abc", "\\q")
scanString String.scan "\\qabc\\q" = NONE
scanString String.scan "abc\\qdef\\qghi" = SOME ("abc", "\\qdef\\qghi")
scanString String.scan "\n" = NONE
scanString String.scan "\nabc" = NONE
scanString String.scan "abc\n" = SOME ("abc", "\n")
scanString String.scan "\nabc\n" = NONE
scanString String.scan "abc\ndef\nghi" = SOME ("abc", "\ndef\nghi")

