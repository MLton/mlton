String.fromString "abc\n" = SOME "abc"
String.fromString "\nabc\n" = NONE
String.fromString "abc\ndef\nghi" = SOME "abc"

String.fromCString "" = SOME ""
String.fromCString "\\  \\" = NONE
String.fromCString "\\  \\abc" = NONE
String.fromCString "abc\\  \\" = SOME "abc"
String.fromCString "\\  \\abc\\  \\" = NONE
String.fromCString "abc\\  \\def\\  \\ghi" = SOME "abc"
