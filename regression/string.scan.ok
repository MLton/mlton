Char.fromString "" = NONE
Char.fromString "\\  \\" = NONE
Char.fromString "\\  \\abc" = SOME #"a"
Char.fromString "abc\\  \\" = SOME #"a"
Char.fromString "\\  \\abc\\  \\" = SOME #"a"
Char.fromString "abc\\  \\def\\  \\ghi" = SOME #"a"
Char.fromString "\\n" = SOME #"\n"
Char.fromString "\\nabc" = SOME #"\n"
Char.fromString "abc\\n" = SOME #"a"
Char.fromString "\\nabc\\n" = SOME #"\n"
Char.fromString "abc\\ndef\\nghi" = SOME #"a"
Char.fromString "\\q" = NONE
Char.fromString "\\qabc" = NONE
Char.fromString "abc\\q" = SOME #"a"
Char.fromString "\\qabc\\q" = NONE
Char.fromString "abc\\qdef\\qghi" = SOME #"a"
Char.fromString "\n" = NONE
Char.fromString "\nabc" = NONE
Char.fromString "abc\n" = SOME #"a"
Char.fromString "\nabc\n" = NONE
Char.fromString "abc\ndef\nghi" = SOME #"a"

String.fromString "" = SOME ""
